# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration (Vite)
# Leave empty to use relative /api routes against the integrated Express server
VITE_API_BASE_URL=""
# Configurable demonstration contact details
VITE_WHATSAPP_NUMBER="6281200000000"
VITE_CONTACT_EMAIL="halo@safah-travel-demo.example"
VITE_OFFICE_ADDRESS="Jl. Contoh Kebayoran Baru No. 18, Jakarta Selatan 12160 (Alamat Simulasi)"

# Optional MySQL Configuration (when deploying with an external MySQL 8 database)
# If DB_HOST and DB_NAME are omitted, the server uses local SQLite persistence automatically.
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
